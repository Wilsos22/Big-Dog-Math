node_modules
.next
out
dist
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.tsbuildinfo
.data

# AI Studio scratch environments (large binaries, never commit)
aistudio_*

# mastery golden-test build artifact
.tmp-mastery/

# Steele's local piles in the working folder - visible in Finder, never for git.
# Mass-staging these during a GitHub Desktop pull is what caused the 7/21
# add/add conflict mess.
Big_Dog_Thinking_Posters/
Codex Downloads/
Claude Design Wireframe/*.zip
Claude Design Wireframe/*-handoff*
output/

# Repomix packs are a whole-codebase dump written to the repo root. They are for
# handing to an outside model, never for committing - and a pack made from a
# stale checkout is what produced a confidently wrong privacy audit on
# 2026-07-30. Regenerate one when you need it; never review one from disk.
repomix-*.xml
repomix-output.*

# Roster and student-data files must never be committable. The only CSV that
# belongs in this repo is scripts/fixtures/*.csv, which is fully fictional
# (mock.bigdogmath.example). See rule 8.
*.csv
!scripts/fixtures/*.csv
*roster*.csv
*.roster.json
# The EXTENSION was the wrong thing to key on. Found 2026-07-30: a file called
# "26-27 roster emails.pdf" was sitting untracked and NOT ignored in the working
# folder, one `git add .` away from putting real student emails in a public
# GitHub repo. The district exports rosters as PDF and XLSX as readily as CSV,
# so match the WORD, whatever it is attached to, and re-allow the source paths
# that legitimately carry it.
*roster*
*Roster*
!src/app/roster/
!src/app/roster/**
!src/app/api/roster/
!src/app/api/roster/**
!src/app/api/teacher/roster/
!src/app/api/teacher/roster/**
!src/app/api/teacher/spinner-roster/
!src/app/api/teacher/spinner-roster/**
!warmup-roster-push.gs
!scripts/import-roster.py
!scripts/fixtures/*roster*
# The other shapes district student data arrives in.
*.xlsx
*.xls
*student*.pdf
*students*.pdf
